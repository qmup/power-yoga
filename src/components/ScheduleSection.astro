---
import { CMS, SITE, WEEK_DAYS } from '../data/cms';

const section = CMS.scheduleSection;

const filters = [
  { id: 'all', label: 'Tất cả ca tập' },
  { id: 'senior', label: 'Gợi ý nhẹ nhàng cho cô chú' },
  { id: 'morning', label: 'Buổi sáng (05:00 – 09:00)' },
  { id: 'afternoon', label: 'Buổi chiều & tối (16:00 – 19:45)' },
];
---

<section id="lich-tap" class="bg-ivory py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] text-clay uppercase">
          {section.eyebrow}
        </p>
        <h2 class="mt-3 font-display text-3xl leading-tight font-semibold text-ink sm:text-5xl">
          {section.titleLine1}<br />{section.titleLine2}
        </h2>
      </div>
      <p class="max-w-md text-base leading-relaxed text-ink-soft">
        {section.description}
      </p>
    </div>

    <!-- Controls Bar: Filters + 2-Style View Switcher -->
    <div class="mt-9 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <!-- Filter Pills -->
      <div class="flex flex-wrap gap-2.5" role="group" aria-label="Bộ lọc khung giờ tập">
        {filters.map((f, idx) => (
          <button
            type="button"
            data-schedule-filter={f.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class:list={[
              'min-h-[44px] cursor-pointer rounded-full border px-4.5 py-2 text-[14.5px] font-medium transition-all duration-200',
              idx === 0
                ? 'border-ink bg-ink text-ivory'
                : 'border-ink/12 bg-surface text-ink-soft hover:border-ink/35 hover:text-ink',
            ]}
          >
            {f.label}
          </button>
        ))}
      </div>

      <!-- Segmented View Style Switcher (Default: Fanpage Timetable Grid) -->
      <div
        class="inline-flex w-fit items-center rounded-full border border-ink/10 bg-cream p-1"
        role="group"
        aria-label="Chuyển đổi kiểu hiển thị lịch tập"
      >
        <button
          type="button"
          data-schedule-view="grid"
          aria-pressed="true"
          class="inline-flex min-h-[40px] cursor-pointer items-center gap-2 whitespace-nowrap rounded-full bg-sage-dark px-4 py-1.5 text-sm font-semibold text-ivory shadow-2xs transition-all duration-200"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          <span>Thời khóa biểu</span>
        </button>

        <button
          type="button"
          data-schedule-view="list"
          aria-pressed="false"
          class="inline-flex min-h-[40px] cursor-pointer items-center gap-2 whitespace-nowrap rounded-full bg-transparent px-4 py-1.5 text-sm font-semibold text-ink-soft transition-all duration-200 hover:text-ink"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6" />
            <line x1="8" y1="12" x2="21" y2="12" />
            <line x1="8" y1="18" x2="21" y2="18" />
            <circle cx="4" cy="6" r="1" fill="currentColor" />
            <circle cx="4" cy="12" r="1" fill="currentColor" />
            <circle cx="4" cy="18" r="1" fill="currentColor" />
          </svg>
          <span>Danh sách theo ca</span>
        </button>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- STYLE 1 (DEFAULT): FANPAGE-INSPIRED WEEKLY TIMETABLE (PURE CODE)    -->
    <!-- =================================================================== -->
    <div id="schedule-view-grid" class="mt-8">
      <div class="overflow-hidden rounded-[2rem] border border-ink/10 bg-[#F3EFE6] p-4 shadow-[0_24px_60px_-34px_rgba(36,31,27,0.18)] sm:p-7">
        <!-- Timetable Top Header (Echoing Fanpage Poster) -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-ink/8 pb-5">
          <div>
            <p class="font-display text-3xl leading-none font-semibold text-ink sm:text-4xl">
              {section.posterTitle}
            </p>
            <p class="mt-2 text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase sm:text-[13px]">
              {section.posterSubtitle}
            </p>
            <div class="mt-2.5 flex flex-wrap items-center gap-4 text-xs font-medium text-ink-soft">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-sage"></span>
                <span>Lớp nhẹ nhàng / trị liệu cho cô chú</span>
              </span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-clay lg:hidden">
                <span>← Vuốt ngang xem cả tuần →</span>
              </span>
            </div>
          </div>

          <img
            src={SITE.logoImage}
            alt={`Logo chính thức ${SITE.name}`}
            loading="lazy"
            decoding="async"
            class="h-14 w-auto shrink-0 object-contain sm:h-16"
          />
        </div>

        <!-- Scrollable 7-Day Matrix with Sticky Time Column on Mobile -->
        <div class="mt-5 overflow-x-auto pb-2">
          <table class="w-full min-w-[1040px] table-fixed border-separate border-spacing-x-2 border-spacing-y-2.5 text-center">
            <colgroup>
              <col class="w-[132px]" />
              {WEEK_DAYS.map(() => (
                <col />
              ))}
            </colgroup>
            <thead>
              <tr>
                <th scope="col" class="sticky left-0 z-20 w-[132px] bg-[#F3EFE6] px-1 py-1 text-left align-middle">
                  <span class="block text-center text-[11px] font-semibold tracking-[0.16em] text-ink-muted uppercase">
                    Khung giờ
                  </span>
                </th>
                {WEEK_DAYS.map((day) => (
                  <th scope="col" class="px-0.5 py-1">
                    <div class="rounded-xl bg-[#636E5B] px-3 py-2.5 text-sm font-semibold tracking-wide text-ivory shadow-2xs">
                      {day.shortLabel}
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {section.slots.map((slot) => {
                const byDay = new Map(slot.sessions.map((s) => [s.dayKey, s]));
                return (
                  <tr data-grid-row data-period={slot.period}>
                    <!-- Sticky Left Time Pill -->
                    <th scope="row" class="sticky left-0 z-10 bg-[#F3EFE6] pr-1 align-middle font-normal">
                      <div class="flex h-[7.25rem] items-center justify-center rounded-2xl bg-[#A9A18E] px-2.5 py-2 text-xs font-semibold tracking-tight whitespace-nowrap text-white shadow-2xs sm:text-[13px]">
                        {slot.time}
                      </div>
                    </th>

                    <!-- 7 Day Cells — Uniform Fixed Width & Height -->
                    {WEEK_DAYS.map((day) => {
                      const session = byDay.get(day.key);
                      if (!session) {
                        return (
                          <td class="p-0 align-middle">
                            <div
                              aria-label={`${day.fullLabel} ${slot.time}: Chưa có lớp`}
                              class="flex h-[7.25rem] items-center justify-center rounded-2xl bg-surface/55 text-xs text-ink-muted/40"
                            >
                              —
                            </div>
                          </td>
                        );
                      }

                      return (
                        <td class="p-0 align-middle">
                          <div
                            data-grid-cell
                            data-senior={String(session.seniorFriendly)}
                            class:list={[
                              'relative flex h-[7.25rem] flex-col items-center justify-center overflow-hidden rounded-2xl px-2.5 py-2 transition-all duration-300',
                              session.special
                                ? 'border border-dashed border-ink/35 bg-[#E7E1D4]'
                                : 'border border-ink/6 bg-surface shadow-[0_6px_18px_-14px_rgba(36,31,27,0.22)]',
                            ]}
                          >
                            {session.seniorFriendly && (
                              <span
                                title="Lớp nhẹ nhàng · Phù hợp cho cô chú mới tập / trị liệu"
                                class="absolute top-2 right-2 h-2 w-2 rounded-full bg-sage"
                              ></span>
                            )}
                            <p class="line-clamp-2 text-[13px] leading-tight font-semibold text-ink">
                              {session.titleVi}
                            </p>
                            <p class="mt-1 line-clamp-1 text-[11.5px] leading-tight italic text-ink-soft">
                              {session.titleEn}
                            </p>
                            <p class="mt-1.5 line-clamp-1 text-[11px] font-medium text-ink-muted">
                              {session.teacher}
                            </p>
                          </div>
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Subtle Footer Line inside Timetable -->
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-ink/8 pt-4 text-xs text-ink-soft">
          <p>● {section.footerNote}</p>
          <p class="font-medium text-ink-muted">
            Hotline / Zalo: <a href={SITE.contact.telHref} class="font-semibold text-ink hover:underline">{SITE.contact.phoneDisplay}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- STYLE 2: DETAILED CARD LIST BY TIME SLOT (EXISTING VIEW PRESERVED)  -->
    <!-- =================================================================== -->
    <div id="schedule-view-list" class="mt-8 hidden space-y-6">
      {section.slots.map((slot) => (
        <div
          data-schedule-slot
          class="rounded-[1.75rem] border border-ink/8 bg-surface p-5 shadow-2xs sm:p-7"
        >
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/8 pb-4">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-cream px-4 py-1.5 font-display text-xl font-semibold text-ink sm:text-2xl">
                {slot.time}
              </span>
              <span class="text-sm font-medium text-ink-muted">{slot.periodLabel}</span>
            </div>
            <span class="text-xs font-medium text-sage-dark">
              ● Có phiên dịch hỗ trợ tại phòng tập
            </span>
          </div>

          <div class="mt-5 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
            {slot.sessions.map((session) => (
              <div
                data-schedule-card
                data-period={slot.period}
                data-senior={String(session.seniorFriendly)}
                class:list={[
                  'flex flex-col justify-between rounded-2xl border p-4 transition-colors',
                  session.seniorFriendly
                    ? 'border-sage/25 bg-sage-soft/40'
                    : 'border-ink/8 bg-ivory/70',
                ]}
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-bold tracking-wider text-clay uppercase">
                      {session.day}
                    </span>
                    {session.seniorFriendly && (
                      <span class="rounded-full bg-sage-soft px-2.5 py-0.5 text-[11px] font-semibold text-sage-dark">
                        Nhẹ nhàng · Dễ theo
                      </span>
                    )}
                  </div>
                  <h3 class="mt-2 font-sans text-base font-semibold text-ink">
                    {session.name}
                  </h3>
                  {session.note && (
                    <p class="mt-1 text-sm text-ink-soft">{session.note}</p>
                  )}
                </div>

                <p class="mt-3 text-xs font-medium text-ink-muted">
                  Hướng dẫn: <span class="text-ink">{session.teacher}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Helper Banner -->
    <div data-reveal class="mt-8 flex flex-col items-start justify-between gap-5 rounded-[1.75rem] border border-clay/20 bg-cream/85 p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <p class="font-display text-2xl font-semibold text-ink">
          {section.bannerTitle}
        </p>
        <p class="mt-1 text-[15px] text-ink-soft">
          {section.bannerDescription}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2.5">
        <a
          href={SITE.contact.telHref}
          class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-sage-dark px-5 py-3 text-sm font-semibold text-ivory transition-colors hover:bg-sage"
        >
          Gọi {SITE.contact.phoneDisplay}
        </a>
        <a
          href={SITE.contact.zaloHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-zalo/25 bg-zalo-soft px-5 py-3 text-sm font-semibold text-zalo-ink transition-colors hover:bg-zalo hover:text-white"
        >
          Nhắn Zalo
        </a>
        <a
          href={SITE.contact.messengerHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-messenger/25 bg-messenger-soft px-5 py-3 text-sm font-semibold text-messenger-ink transition-colors hover:bg-messenger hover:text-white"
        >
          Messenger
        </a>
      </div>
    </div>
  </div>
</section>
