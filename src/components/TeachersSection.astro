---
import { CMS } from '../data/cms';

const section = CMS.teachersSection;
---

<section id="giao-vien" class="bg-warm-section py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] text-sage-dark uppercase">
          {section.eyebrow}
        </p>
        <h2 class="mt-3 font-display text-3xl leading-tight font-semibold text-ink sm:text-5xl">
          {section.titleLine1}<br />{section.titleLine2}
        </h2>
      </div>
      <p class="max-w-md text-base leading-relaxed text-ink-soft">
        {section.description}
      </p>
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {section.masters.map((master, idx) => (
        <article
          data-reveal
          data-delay={String(idx * 0.1)}
          class="zen-card group flex flex-col overflow-hidden rounded-[2rem]"
        >
          <div class="relative aspect-[4/4.6] overflow-hidden bg-cream">
            <img
              src={master.image}
              alt={master.imageAlt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-[50%_22%] transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink/55 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="inline-block rounded-full bg-ivory/92 px-3.5 py-1 text-xs font-semibold text-ink backdrop-blur-sm">
                {master.role}
              </span>
            </div>
          </div>

          <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
            <div>
              <h3 class="font-display text-2xl font-semibold text-ink sm:text-[1.75rem]">
                {master.name}
              </h3>
              <p class="mt-1.5 text-xs font-semibold tracking-wide text-clay uppercase">
                {master.specialty}
              </p>
              <p class="mt-3.5 text-[15.5px] leading-relaxed text-ink-soft">
                {master.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
