---
import { SITE } from '../data/site';
---

<section id="lien-he" class="bg-cream/90 pt-20 pb-28 sm:pt-28 sm:pb-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-stretch">
      <!-- Contact Details Card -->
      <div data-reveal class="flex flex-col justify-between rounded-[2.25rem] border border-ink/8 bg-surface p-7 shadow-sm sm:p-10 lg:col-span-6">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-sage-dark uppercase">
            Liên hệ &amp; Chỉ đường tại Biên Hòa – Đồng Nai
          </p>
          <h2 class="mt-3 font-display text-3xl leading-tight font-semibold text-ink sm:text-5xl">
            Hân hạnh đón tiếp cô chú<br />đến tham quan phòng tập
          </h2>

          <div class="mt-8 space-y-5 text-[15.5px]">
            <!-- Address (Both New & Legacy for Clarity + Local SEO) -->
            <div class="flex items-start gap-4">
              <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sage-soft text-sage-dark" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Địa chỉ phòng tập</p>
                <p class="mt-1 font-semibold text-ink">
                  {SITE.address.current}
                </p>
                <p class="mt-1 text-sm text-ink-soft">
                  <em>(Địa chỉ cũ: {SITE.address.legacy})</em>
                </p>
                <p class="mt-1.5 inline-block rounded-lg bg-clay-soft px-3 py-1 text-sm font-medium text-clay">
                  📍 {SITE.address.landmark}
                </p>
              </div>
            </div>

            <!-- Hotline / Zalo -->
            <div class="flex items-start gap-4">
              <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-cream text-ink" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Hotline &amp; Zalo tư vấn</p>
                <a href={SITE.contact.telHref} class="mt-1 block font-display text-3xl font-semibold text-ink hover:text-sage-dark">
                  {SITE.contact.phoneDisplay}
                </a>
                <p class="text-sm text-ink-soft">
                  Email: <a href={`mailto:${SITE.contact.email}`} class="underline-offset-4 hover:underline">{SITE.contact.email}</a>
                </p>
              </div>
            </div>

            <!-- Opening Hours -->
            <div class="flex items-start gap-4">
              <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-cream text-clay" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Giờ mở cửa</p>
                <p class="mt-1 font-semibold text-ink">{SITE.hours.summary}</p>
                <p class="text-sm text-ink-soft">{SITE.hours.classesSummary}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Direct Action Buttons — 3 Distinct Channel Styles -->
        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <a
            href={SITE.contact.telHref}
            class="inline-flex min-h-[52px] items-center justify-center gap-2 whitespace-nowrap rounded-full bg-sage-dark px-4 py-3 text-[15px] font-semibold text-ivory shadow-xs transition-colors hover:bg-sage"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Gọi trực tiếp</span>
          </a>
          <a
            href={SITE.contact.zaloHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[52px] items-center justify-center gap-2 whitespace-nowrap rounded-full border border-zalo/25 bg-zalo-soft px-4 py-3 text-[15px] font-semibold text-zalo-ink transition-colors hover:bg-zalo hover:text-white"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.03 2 11c0 2.75 1.38 5.21 3.55 6.86L4.6 21.6a.5.5 0 0 0 .7.58l4.02-1.8c.85.2 1.75.32 2.68.32 5.52 0 10-4.03 10-9.7C22 6.03 17.52 2 12 2zm-3.1 11.75H6.15a.55.55 0 0 1-.45-.87l2.22-3.28H6.2a.55.55 0 1 1 0-1.1h2.75a.55.55 0 0 1 .45.87l-2.22 3.28H8.9a.55.55 0 1 1 0 1.1zm3.43-.45a.55.55 0 0 1-1.1 0v-.22a1.65 1.65 0 1 1 0-2.66v-.22a.55.55 0 1 1 1.1 0v3.1zm1.8 0a.55.55 0 0 1-1.1 0V8.8a.55.55 0 1 1 1.1 0v4.5zm2.45.45a1.85 1.85 0 1 1 0-3.7 1.85 1.85 0 0 1 0 3.7z"/>
            </svg>
            <span>Nhắn Zalo</span>
          </a>
          <a
            href={SITE.contact.messengerHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[52px] items-center justify-center gap-2 whitespace-nowrap rounded-full border border-messenger/25 bg-messenger-soft px-4 py-3 text-[15px] font-semibold text-messenger-ink transition-colors hover:bg-messenger hover:text-white"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.145 2 11.259c0 2.91 1.454 5.504 3.727 7.197V22l3.405-1.869c.909.252 1.872.388 2.868.388 5.523 0 10-4.145 10-9.26C22 6.145 17.523 2 12 2zm1.003 12.463-2.548-2.718-4.97 2.718 5.468-5.804 2.61 2.718 4.908-2.718-5.468 5.804z" />
            </svg>
            <span>Messenger</span>
          </a>
        </div>
      </div>

      <!-- Google Maps Embed & Quick Links -->
      <div data-reveal data-delay="0.1" class="flex flex-col overflow-hidden rounded-[2.25rem] border border-ink/8 bg-surface shadow-sm lg:col-span-6">
        <div class="relative min-h-[340px] flex-1 bg-beige">
          <iframe
            title="Bản đồ vị trí Power Yoga Đồng Nai — 71/81A Quốc Lộ 51, Biên Hòa, Đồng Nai"
            src={SITE.contact.googleMapsEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full min-h-[340px] w-full border-0"
          ></iframe>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/8 bg-ivory/80 px-6 py-5">
          <div>
            <p class="text-sm font-semibold text-ink">Dễ dàng tìm đường trên điện thoại</p>
            <p class="text-xs text-ink-soft">Khu vực Quốc lộ 51 — Ngay sau lưng Big C Đồng Nai</p>
          </div>
          <a
            href={SITE.contact.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-ivory transition-colors hover:bg-sage-dark"
          >
            <span>Mở Google Maps</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Clean Minimalist Footer -->
    <footer class="mt-16 border-t border-ink/10 pt-10">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <p class="font-display text-2xl font-semibold text-ink">{SITE.name}</p>
          <p class="mt-1 text-sm text-ink-soft">
            {SITE.motto}
          </p>
          <p class="mt-2 text-xs text-ink-muted">
            Phòng tập Yoga Biên Hòa · Yoga Đồng Nai · Yoga trị liệu &amp; Yoga cho người lớn tuổi tại Long Hưng – Long Bình Tân.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-5 text-sm font-medium text-ink-soft">
          <a href={SITE.contact.facebookUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
            Fanpage Facebook
          </a>
          <a href={SITE.contact.messengerHref} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
            Messenger
          </a>
          <a href={SITE.contact.zaloHref} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
            Zalo: {SITE.contact.phoneDisplay}
          </a>
          <a href={SITE.contact.consultFormUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
            Phiếu tư vấn
          </a>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted">
        <p>© {new Date().getFullYear()} {SITE.name}. {SITE.tagline}</p>
        <a href="#hero-section" class="font-medium text-ink-soft hover:text-ink">
          Về đầu trang ↑
        </a>
      </div>
    </footer>
  </div>
</section>
