---
import { CMS, SITE } from '../data/cms';

const hero = CMS.hero;
---

<section id="hero-section" class="bg-linen-glow relative pt-26 pb-16 sm:pt-32 sm:pb-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Top Editorial Intro -->
    <div class="grid items-end gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <div data-hero-stagger class="inline-flex items-center gap-2.5 rounded-full border border-clay/25 bg-surface/85 px-4 py-2 text-sm font-medium text-ink-soft shadow-2xs backdrop-blur-sm">
          <span class="animate-breathe inline-block h-2.5 w-2.5 rounded-full bg-sage"></span>
          <span>{hero.badge}</span>
        </div>

        <h1 data-hero-stagger class="mt-6 font-display text-[2.6rem] leading-[1.08] font-semibold text-ink sm:text-[3.6rem] lg:text-[4.35rem]">
          {hero.headlineLine1}<br />
          <span class="italic font-medium text-sage-dark">{hero.headlineAccent}</span><br />
          {hero.headlineLine3}
        </h1>
      </div>

      <div class="lg:col-span-5 lg:pb-2">
        <p data-hero-stagger class="text-lg leading-relaxed text-ink-soft sm:text-[1.15rem]">
          {hero.description}
        </p>

        <!-- High-accessibility Contact CTAs — 3 Distinct Channel Styles -->
        <div data-hero-stagger class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={SITE.contact.telHref}
            class="inline-flex min-h-[54px] items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-sage-dark px-6 py-3.5 text-[15.5px] font-semibold text-ivory shadow-md transition-all duration-300 hover:bg-sage hover:shadow-lg"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Gọi {SITE.contact.phoneDisplay}</span>
          </a>

          <a
            href={SITE.contact.zaloHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[54px] items-center justify-center gap-2.5 whitespace-nowrap rounded-full border border-zalo/25 bg-zalo-soft px-5 py-3 text-[15px] font-semibold text-zalo-ink shadow-xs transition-all duration-300 hover:border-zalo/50 hover:bg-zalo hover:text-white"
          >
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-zalo text-white" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.03 2 11c0 2.75 1.38 5.21 3.55 6.86L4.6 21.6a.5.5 0 0 0 .7.58l4.02-1.8c.85.2 1.75.32 2.68.32 5.52 0 10-4.03 10-9.7C22 6.03 17.52 2 12 2zm-3.1 11.75H6.15a.55.55 0 0 1-.45-.87l2.22-3.28H6.2a.55.55 0 1 1 0-1.1h2.75a.55.55 0 0 1 .45.87l-2.22 3.28H8.9a.55.55 0 1 1 0 1.1zm3.43-.45a.55.55 0 0 1-1.1 0v-.22a1.65 1.65 0 1 1 0-2.66v-.22a.55.55 0 1 1 1.1 0v3.1zm1.8 0a.55.55 0 0 1-1.1 0V8.8a.55.55 0 1 1 1.1 0v4.5zm2.45.45a1.85 1.85 0 1 1 0-3.7 1.85 1.85 0 0 1 0 3.7z"/>
              </svg>
            </span>
            <span>Nhắn Zalo</span>
          </a>

          <a
            href={SITE.contact.messengerHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[54px] items-center justify-center gap-2.5 whitespace-nowrap rounded-full border border-messenger/25 bg-messenger-soft px-5 py-3 text-[15px] font-semibold text-messenger-ink shadow-xs transition-all duration-300 hover:border-messenger/50 hover:bg-messenger hover:text-white"
          >
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-[#007BFF] via-[#7A42F4] to-[#E1306C] text-white" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.145 2 11.259c0 2.91 1.454 5.504 3.727 7.197V22l3.405-1.869c.909.252 1.872.388 2.868.388 5.523 0 10-4.145 10-9.26C22 6.145 17.523 2 12 2zm1.003 12.463-2.548-2.718-4.97 2.718 5.468-5.804 2.61 2.718 4.908-2.718-5.468 5.804z" />
              </svg>
            </span>
            <span>Messenger</span>
          </a>
        </div>

        <p data-hero-stagger class="mt-4 text-sm text-ink-muted">
          {hero.trialNote}
        </p>
      </div>
    </div>

    <!-- Apple-style Cinematic Scroll Showcase Frame -->
    <div data-hero-stagger class="mt-10 sm:mt-14">
      <div
        data-hero-frame
        class="relative overflow-hidden rounded-[2rem] border border-ink/10 bg-cream shadow-[0_32px_80px_-34px_rgba(36,31,27,0.28)]"
      >
        <div class="grid lg:grid-cols-12">
          <!-- Primary sunlit studio visual -->
          <div class="relative aspect-[4/3] overflow-hidden sm:aspect-[16/10] lg:col-span-8 lg:aspect-[16/10]">
            <div data-hero-media class="h-full w-full">
              <img
                src={hero.primaryImage}
                alt={hero.primaryImageAlt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover object-center"
              />
            </div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-end justify-between gap-3 sm:bottom-7 sm:left-7 sm:right-7">
              <div class="rounded-2xl bg-ivory/92 px-4 py-3 backdrop-blur-md">
                <p class="text-xs font-semibold tracking-[0.14em] text-sage-dark uppercase">
                  {hero.primaryBadgeTop}
                </p>
                <p class="mt-0.5 text-sm font-medium text-ink sm:text-base">
                  {hero.primaryBadgeBottom}
                </p>
              </div>
            </div>
          </div>

          <!-- Right editorial highlights panel -->
          <div class="flex flex-col justify-between bg-cream/90 p-6 sm:p-8 lg:col-span-4">
            <div>
              <p class="text-xs font-semibold tracking-[0.18em] text-clay uppercase">
                {hero.sideEyebrow}
              </p>
              <h2 class="mt-3 font-display text-2xl leading-snug font-semibold text-ink sm:text-[1.85rem]">
                {hero.sideTitle}
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
                {hero.sideDescription}
              </p>
            </div>

            <!-- Secondary studio hall preview -->
            <div class="mt-6 overflow-hidden rounded-2xl border border-ink/8 bg-surface">
              <div class="relative aspect-[16/9] overflow-hidden">
                <img
                  src={hero.secondaryImage}
                  alt={hero.secondaryImageAlt}
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover object-left-top scale-[1.08]"
                />
              </div>
              <div class="flex items-center justify-between px-4 py-3 text-xs font-medium text-ink-soft">
                <span>{hero.secondaryHoursLabel}</span>
                <a href="#lich-tap" class="font-semibold text-sage-dark underline-offset-4 hover:underline">
                  Xem lịch tập →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Trust Metrics Strip -->
    <div class="mt-10 grid grid-cols-2 gap-4 sm:mt-14 lg:grid-cols-4 lg:gap-6">
      {SITE.stats.map((stat, idx) => (
        <div
          data-reveal
          data-delay={String(idx * 0.08)}
          class="rounded-3xl border border-ink/8 bg-surface/85 px-5 py-5 text-center sm:px-6 sm:py-6"
        >
          <p class="font-display text-3xl font-semibold text-ink sm:text-4xl">{stat.value}</p>
          <p class="mt-1.5 text-sm font-medium text-ink-soft sm:text-[15px]">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
