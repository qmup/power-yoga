# === Cấu hình trang quản trị /admin cho Power Yoga Đồng Nai ===
# Thiết lập các biến này trong Vercel Project Settings -> Environment Variables

# 1. Tài khoản đăng nhập trang /admin (cấp cho bên quản lý Power Yoga)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=thay-bang-mat-khau-manh-o-day

# 2. Chuỗi bí mật ký cookie đăng nhập (tùy chọn — nếu bỏ trống sẽ tự tạo từ ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=chuoi-ngau-nhien-dai-32-ky-tu

# 3. GitHub Fine-grained Personal Access Token (chỉ cần quyền Contents: Read & Write trên repo power-yoga)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxx

# 4. Repo & nhánh lưu nội dung (mặc định qmup/power-yoga và main)
GITHUB_REPO=qmup/power-yoga
GITHUB_BRANCH=main
