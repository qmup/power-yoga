# === Cấu hình trang quản trị /admin cho Power Yoga Đồng Nai ===
# Thiết lập các biến này trong Vercel Project Settings -> Environment Variables

# 0. Tên miền chính thức khi gắn custom domain (Config — dùng cho sitemap & robots.txt)
SITE_URL=https://power-yoga.vercel.app

# 1. Tài khoản đăng nhập trang /admin (ban đầu / cứu hộ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=thay-bang-mat-khau-manh-o-day

# 2. Chuỗi bí mật ký cookie & link đặt lại mật khẩu (Secret — nên dài >= 32 ký tự)
ADMIN_SESSION_SECRET=chuoi-ngau-nhien-dai-32-ky-tu

# 3. Email nhận link "Quên mật khẩu" (Config — có thể cập nhật trực tiếp trong /admin hoặc ở đây)
ADMIN_RECOVERY_EMAIL=quannmse@gmail.com

# 4. GitHub Fine-grained Personal Access Token (Secret — quyền Contents: Read & Write trên repo power-yoga)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxx

# 5. Repo & nhánh lưu nội dung (Config)
GITHUB_REPO=qmup/power-yoga
GITHUB_BRANCH=main

# === 6. Chọn 1 trong 2 cách gửi email "Quên mật khẩu" (miễn phí) ===

# CÁCH A (Đơn giản nhất với Gmail — không cần tên miền riêng):
# Bật xác minh 2 bước trên Gmail -> tạo App Password 16 ký tự tại https://myaccount.google.com/apppasswords
SMTP_USER=quannmse@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# CÁCH B (Hoặc dùng Resend API — free 3.000 mail/tháng):
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM=Power Yoga Admin <onboarding@resend.dev>
